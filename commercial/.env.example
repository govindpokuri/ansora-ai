# Store as .env inside ansora-private on the server. Never put it in public_html.
AZURE_URL=
AZURE_KEY=
AZURE_MODEL=
AZURE_MODEL_FAMILY=
AZURE_FALLBACK_ENABLED=false
AZURE_FALLBACK_URL=
AZURE_FALLBACK_KEY=
AZURE_FALLBACK_MODEL=gpt-oss-120b
AZURE_FIRST_TEXT_TIMEOUT=8
AZURE_FALLBACK_FIRST_TEXT_TIMEOUT=20
AZURE_FALLBACK_COOLDOWN=30
AZURE_FALLBACK_MAX_TOKENS=4096
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=Ansora AI

# For ZeptoMail SMTP set MAIL_MODE=smtp. Use the exact host/credentials from your ZeptoMail account.
# Leave MAIL_MODE empty to retain config.local.php's existing mail provider.
MAIL_MODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Ansora AI

# HTTPS delivery: MAIL_MODE=zeptomail. Use your account region's API URL.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_FROM=noreply@example.com
ZEPTOMAIL_FROM_NAME=Ansora AI
