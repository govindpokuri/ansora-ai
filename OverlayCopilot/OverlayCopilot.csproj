<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AnsoraAI</AssemblyName>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.15</Version>
    <InformationalVersion>0.1.15-community.1</InformationalVersion>
    <ApplicationIcon>Assets\ansora.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\ansora.ico" /></ItemGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /><PackageReference Include="System.Speech" Version="9.0.0" /><PackageReference Include="Whisper.net" Version="1.9.1" /><PackageReference Include="Whisper.net.Runtime" Version="1.9.1" /></ItemGroup>
  <ItemGroup><None Update="settings.defaults.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" /></ItemGroup>
  <ItemGroup><PackageReference Include="PdfPig" Version="0.1.12" /></ItemGroup>
</Project>
