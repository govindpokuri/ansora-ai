<Window x:Class="OverlayCopilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Call Assistant" Icon="Assets/ansora.ico" Width="1060" Height="760" MinWidth="900" MinHeight="720" Background="Transparent" AllowsTransparency="True" Foreground="#E8EDF7" FontFamily="Segoe UI" Topmost="True" ShowInTaskbar="False" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <SolidColorBrush x:Key="OverlayBackground" Color="#101827"/>
  <SolidColorBrush x:Key="OverlayPanelBackground" Color="#1B2638"/>
  <SolidColorBrush x:Key="OverlayAnswerBackground" Color="#F3F6FC"/>
  <SolidColorBrush x:Key="OverlaySecondaryText" Color="#9CAEC5"/>
  <SolidColorBrush x:Key="OverlayAnswerText" Color="#17243A"/>
  <SolidColorBrush x:Key="OverlayAnswerSecondaryText" Color="#536781"/>
  <SolidColorBrush x:Key="OverlayAnswerHeading" Color="#356960"/>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Effect" Value="{DynamicResource OverlayTextShadow}"/></Style>
 </Window.Resources>
 <Border Background="{DynamicResource OverlayBackground}" BorderBrush="#34425A" BorderThickness="1" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Thumb x:Name="MoveHandle" DragDelta="MoveHandleDragDelta" PreviewKeyDown="MoveHandleKeyDown" Cursor="SizeAll" Focusable="True" AutomationProperties.Name="Move window">
     <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><StackPanel><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Live caller questions. Clear, natural answers.  ·  Drag to move" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></ControlTemplate></Thumb.Template>
    </Thumb>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="UpdateBadge" Click="UpdateClick" Visibility="Collapsed" Background="#F6C453" AutomationProperties.Name="Update available - install latest version"><TextBlock x:Name="UpdateBadgeLabel" Text="↑ Update available" Foreground="#17243A" FontWeight="SemiBold" TextWrapping="NoWrap"/></Button>
     <Button Content="Options" Click="OptionsClick" VerticalAlignment="Center"/>
    </StackPanel>
    <Button x:Name="HideButton" Grid.Column="2" Content="Hide" Click="HideClick" VerticalAlignment="Center" ToolTip="Restore with Ctrl+Alt+H"/>
    <Button Grid.Column="3" Content="✕" Click="ExitClick" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="Close"/>
   </Grid>
   <Border Grid.Row="1" Background="{DynamicResource OverlayPanelBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,18">
    <StackPanel>
     <DockPanel><TextBlock x:Name="MinutesLeft" DockPanel.Dock="Right" Text="Estimating minutes left…" Foreground="#D1E6F4" VerticalAlignment="Center" ToolTip="Based on this call's measured AI usage after two minutes and three answers. An estimate, not a guarantee."/><Button x:Name="ListenButton" Content="Start listening" Click="ListenClick" Background="#137F76"/><Button x:Name="AnswerButton" Visibility="Collapsed" Content="Answer now" Click="AnswerClick"/><TextBlock x:Name="AnswerStatus" Text="Ready to read" Foreground="#85DED0" VerticalAlignment="Center" Margin="10,0,0,0"/></DockPanel>

    </StackPanel>
   </Border>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource OverlayPanelBackground}" CornerRadius="10" Padding="18">
     <TabControl x:Name="QuestionTabs" SelectionChanged="QuestionTabChanged" Background="{DynamicResource OverlayPanelBackground}" BorderThickness="0" Foreground="#E8EDF7">
      <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Background" Value="#293B58"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,8" Margin="0,0,6,8"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#137F76"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
      <TabItem><TabItem.Header><TextBlock Text="Caller" Foreground="#FFFFFF"/></TabItem.Header>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="CALLER" Foreground="#85DED0" FontSize="11" FontWeight="Bold"/>
      <ScrollViewer Grid.Row="1" MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,12,0,18"><TextBlock x:Name="CallerQuestionText" Text="The caller’s question will appear here as they speak." FontSize="20" FontWeight="SemiBold" LineHeight="29"/></ScrollViewer>
      <TextBlock Grid.Row="2" Text="LIVE TRANSCRIPT" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox Grid.Row="3" x:Name="TranscriptBox" Effect="{DynamicResource OverlayTextShadow}" IsReadOnly="True" TextWrapping="Wrap" FontSize="14" BorderThickness="0" Background="{DynamicResource OverlayPanelBackground}" Padding="0" VerticalScrollBarVisibility="Auto"/>
      <StackPanel Grid.Row="4"><TextBlock x:Name="DraftText" Text="Only caller audio is transcribed." Foreground="{DynamicResource OverlaySecondaryText}" FontSize="11" Margin="0,10,0,0"/><StackPanel x:Name="QuestionPanel" Visibility="Collapsed"><TextBlock Text="Edit question"/><TextBox x:Name="QuestionBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"/></StackPanel></StackPanel>
     </Grid>
      </TabItem>
      <TabItem><TabItem.Header><TextBlock Text="Text &amp; code" Foreground="#FFFFFF"/></TabItem.Header>
       <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Paste a question, problem, or code using Ctrl+V. Include examples and constraints." TextWrapping="Wrap" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="12" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" x:Name="ManualQuestionBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" PreviewKeyDown="ManualQuestionKeyDown" AutomationProperties.Name="Pasted question or coding problem"/>
        <StackPanel Grid.Row="2" Margin="0,10,0,0"><CheckBox x:Name="CodingAnswer" Content="Include a coding solution" IsChecked="True" Foreground="#E8EDF7" Margin="0,0,0,8"/><Button x:Name="ManualAnswerButton" Content="Get answer" Click="ManualAnswerClick" Background="#137F76" Margin="0" ToolTip="Ctrl+Enter sends; click again to cancel"/></StackPanel>
        <TextBlock Grid.Row="3" Text="Ctrl+Enter sends · caller transcription continues. Automatic answers pause on this tab. Resume them from Caller." TextWrapping="Wrap" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="11" Margin="0,10,0,0"/>
       </Grid>
      </TabItem>
     </TabControl>
    </Border>
    <Grid Grid.Column="2" x:Name="AnswerPanel">
     <Border Background="{DynamicResource OverlayAnswerBackground}" CornerRadius="10" Padding="24">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="SmallerTextClick" Background="#DFE7F2" ToolTip="Smaller answer text" AutomationProperties.Name="Smaller answer text"><TextBlock Text="A−" Foreground="#253854" FontWeight="SemiBold"/></Button><Button Click="LargerTextClick" Background="#DFE7F2" Margin="0" ToolTip="Larger answer text" AutomationProperties.Name="Larger answer text"><TextBlock Text="A+" Foreground="#253854" FontWeight="SemiBold"/></Button></StackPanel><TextBlock Text="SUGGESTED ANSWER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OverlayAnswerHeading}" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Grid.Row="1" x:Name="AnswerQuestionText" Text="Waiting for a caller question" Foreground="{DynamicResource OverlayAnswerSecondaryText}" FontSize="13" Margin="0,14,0,16" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
       <RichTextBox Grid.Row="2" x:Name="AnswerDisplay" Effect="{DynamicResource OverlayTextShadow}" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource OverlayAnswerText}" VerticalScrollBarVisibility="Auto" Padding="0"/>
       <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="PinAnswer" Margin="0" VerticalAlignment="Center" ToolTip="Keep this answer visible and pause new automatic AI requests. Transcription continues."><TextBlock Text="Keep this on screen" Foreground="{DynamicResource OverlayAnswerSecondaryText}"/></CheckBox>
        <ComboBox x:Name="AnswerHistory" Grid.Column="1" SelectedIndex="0" MinHeight="32" SelectionChanged="AnswerHistoryChanged" Margin="14,0,0,0" ToolTip="Review recent answers; selecting history holds automatic answers"><ComboBoxItem Content="Live answer · follow newest"/></ComboBox>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="Speak in your own words · adapt examples to your actual experience" Foreground="{DynamicResource OverlayAnswerSecondaryText}" FontSize="11"/>
       </Grid>
      </Grid>
     </Border>
     <TextBox x:Name="AnswerBox" Visibility="Collapsed" TextChanged="AnswerTextChanged" Text="Your answer will appear here."/>
    </Grid>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="ProtectionStatus" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource OverlaySecondaryText}" ToolTip="Capture exclusion depends on the sharing software."/><TextBlock Text="Ctrl+Alt+L listen  ·  Ctrl+Alt+T desktop clicks  ·  Ctrl+Alt+H hide  ·  Ctrl+Alt+Q exit" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="11"/></DockPanel>
   <Border Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Width="620" MaxHeight="520" Margin="0,80,0,0" Background="{DynamicResource OverlayPanelBackground}" BorderBrush="#526681" BorderThickness="1" CornerRadius="10" Padding="20" Visibility="{Binding Visibility, ElementName=OptionsPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
      <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="120"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="VerticalAlignment" Value="Center"/></Style></StackPanel.Resources>
      <DockPanel Margin="0,0,0,14"><Button Content="Done" Click="OptionsClick" DockPanel.Dock="Right" Width="72" Margin="0"/><TextBlock Text="Options" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <WrapPanel x:Name="OptionsActions">
       <Button x:Name="UpdateButton" Content="Updates" Click="UpdateClick" Visibility="Collapsed" ToolTip="Check for a new version"/>
       <Button x:Name="AccountButton" Click="AccountClick" Visibility="Collapsed"><TextBlock x:Name="AccountButtonLabel" Text="Sign in" MaxWidth="94" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Button>
       <Button x:Name="ResumeButton" Content="Resume" Click="ResumeClick"/>
       <Button Content="Settings" Click="SettingsClick"/>
       <Button x:Name="ExportButton" Content="Export a copy" Click="ExportCallClick" IsEnabled="False"/>
       <Button Content="Saved calls" Click="SavedCallsClick"/>
       <Button Content="Clear" Click="ClearClick"/>
       <TextBlock x:Name="TokenSummary" Visibility="Collapsed"/>
      </WrapPanel>
     <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="AutoAnswer" Content="Automatic answers" IsChecked="True" Checked="AutoAnswerChanged" Unchecked="AutoAnswerChanged" Margin="0,8,20,4"/><CheckBox x:Name="ClickThrough" Content="Pass clicks to desktop" ToolTip="This disables clicking and scrolling in the overlay. Press Ctrl+Alt+T to restore controls." Checked="ClickThroughChanged" Unchecked="ClickThroughChanged" Margin="0,8,20,4"/><CheckBox x:Name="TranscriptOnly" Content="Transcript only" IsChecked="False" Checked="FocusModeChanged" Unchecked="FocusModeChanged" Margin="0,8,0,4"/></WrapPanel>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Background" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" Value="1" Width="150" Margin="10,0" SmallChange="0.05" LargeChange="0.1" ValueChanged="BackgroundOpacityChanged" PreviewMouseLeftButtonUp="SaveBackgroundOpacity" KeyUp="SaveBackgroundOpacity" AutomationProperties.Name="Background opacity" ToolTip="Drag left for a transparent background; right for a solid background. Text stays visible."/><TextBlock Text="{Binding Value, ElementName=BackgroundOpacitySlider, StringFormat={}{0:P0}}" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="12" Width="38" VerticalAlignment="Center"/></StackPanel>
     <TextBlock x:Name="InteractionHint" Visibility="Collapsed" Text="Desktop clicks enabled · this window cannot be clicked or scrolled. Ctrl+Alt+T restores controls." Foreground="#F3CF8B" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="Status" Text="Ready · choose your call audio device in Settings." Foreground="{DynamicResource OverlaySecondaryText}" FontSize="12" Margin="0,6,0,0"/>
     <ProgressBar x:Name="AudioMeter" Minimum="0" Maximum="100" Height="3" Background="#30415A" Foreground="#66D9CC" Margin="0,9,0,0"/>
     <TextBlock x:Name="AudioStatus" Text="Caller audio only · use the headphones selected for your call." Foreground="{DynamicResource OverlaySecondaryText}" FontSize="11" Margin="0,5,0,0"/>
     <TextBlock x:Name="CandidateStatus" Text="No candidate profile · upload a resume to personalise answers" Foreground="{DynamicResource OverlaySecondaryText}" FontSize="11" Margin="0,5,0,0"/>
     <TextBlock x:Name="CommercialSummary" Text="Sign in to use your account tokens." Visibility="Collapsed" Foreground="#85DED0" FontSize="11" Margin="0,5,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Grid.RowSpan="4" Background="#101827" BorderBrush="#425571" BorderThickness="1" CornerRadius="8" Padding="24">
    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsPanel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button Content="Done" Click="SettingsClick" DockPanel.Dock="Right" Margin="0"/><TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Expander x:Name="SettingsPanel" Header="Endpoints &amp; audio settings" Margin="0,12,0,12">
      <StackPanel Margin="0,12,0,0">
       <StackPanel x:Name="CaptureSettings"><CheckBox x:Name="UseLocalSpeech" Content="Use local Whisper English transcription (no speech endpoint)" IsChecked="True"/>
       <TextBlock Text="Audio source"/><ComboBox x:Name="AudioSource" SelectedIndex="0" IsEnabled="False" SelectionChanged="AudioSourceChanged" Margin="0,4,0,10"><ComboBoxItem Content="Caller only · speakers / headphones"/></ComboBox>
       <TextBlock Text="Audio device (choose the one used by your call)"/>
       <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,6,0,10"/>
       <Button Content="Refresh devices" Click="RefreshDevicesClick" HorizontalAlignment="Left" Margin="0,0,0,12"/>
       </StackPanel><StackPanel x:Name="SpeechEndpointSettings"><TextBlock Text="Transcription URL · multipart WAV → JSON { text }"/><TextBox x:Name="TranscriptionUrl"/>
       <TextBlock Text="Transcription model (optional)"/><TextBox x:Name="TranscriptionModel"/>
       
       <TextBlock Text="Transcription authentication"/><ComboBox x:Name="TranscriptionAuth" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="Bearer"/><ComboBoxItem Content="api-key"/></ComboBox>
       </StackPanel><StackPanel x:Name="AiEndpointSettings"><TextBlock Text="AI URL · chat-completions-compatible JSON"/><TextBox x:Name="AnswerUrl"/>
       <TextBlock Text="AI model"/><TextBox x:Name="AnswerModel"/>
       <TextBlock Text="Max answer tokens"/><TextBox x:Name="MaxTokens"/>
       <TextBlock Text="Temperature (0–1)"/><TextBox x:Name="Temperature"/>
       
       <TextBlock Text="AI authentication"/><ComboBox x:Name="AnswerAuth" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="api-key"/><ComboBoxItem Content="Bearer"/></ComboBox>
       </StackPanel><Button x:Name="TestAiButton" Content="Test AI connection" Click="TestAiClick" HorizontalAlignment="Left"/><TextBlock Text="Answer instructions"/><TextBox x:Name="SystemPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
       <Button Content="Save settings" Click="SaveSettingsClick" HorizontalAlignment="Left"/>
       <TextBlock Text="Calls are saved automatically to Documents/Ansora AI Community/Calls on this PC, including transcripts, answers and request context. Delete these files when no longer needed. Local speech mode keeps audio on this PC; endpoint mode sends it to your transcription service. Questions go to your AI endpoint. Provider retention policies still apply." Foreground="#AAB9D0" FontSize="12" Margin="0,12,0,0"/>
      </StackPanel>
     </Expander></ScrollViewer></Grid>
   </Border>
  </Grid>
 </Border>
</Window>






